# ── Firebase web config ────────────────────────────────────────────────────
# Same project as the ilmTrack mobile app (ilmtrack-f6c8c).
# Firebase Console > Project Settings > Your apps > Web app.
# These are the EXPO_PUBLIC_* values from ../ilmTrack/.env, renamed.
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# ── Server credentials ─────────────────────────────────────────────────────
# Firebase Console > Project Settings > Service accounts > Generate new private key.
# Drop the JSON into ./service-account/ — everything in that folder is gitignored.
# Not needed when FIREBASE_USE_EMULATOR=true.
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account/serviceAccountKey.json

# ── Admin allowlist ────────────────────────────────────────────────────────
# Comma-separated. Only these emails may sign in to this portal, no matter
# what custom claims their account carries. Removing someone here locks them
# out on their next request. Run `npm run grant` after editing.
ADMIN_EMAILS=you@example.com

# ── Emulator ───────────────────────────────────────────────────────────────
# true = talk to the local Firebase emulators instead of production.
# Run in ../ilmTrack: firebase emulators:start --only auth,firestore,functions
FIREBASE_USE_EMULATOR=false
FIREBASE_EMULATOR_HOST=127.0.0.1
# The browser needs its own copy (only NEXT_PUBLIC_* vars reach client code).
# Keep these two in sync with the pair above.
NEXT_PUBLIC_FIREBASE_USE_EMULATOR=false
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
