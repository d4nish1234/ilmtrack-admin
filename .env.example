# ── Firebase web config ────────────────────────────────────────────────────
# Same project as the ilmTrack mobile app (ilmtrack-f6c8c).
# Firebase Console > Project Settings > Your apps > Web app.
# These are the EXPO_PUBLIC_* values from ../ilmTrack/.env, renamed.
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# ── Server credentials ─────────────────────────────────────────────────────
# Firebase Console > Project Settings > Service accounts > Generate new private key.
# Not needed when FIREBASE_USE_EMULATOR=true.
#
# Locally: drop the JSON into ./service-account/ (that folder is gitignored)
# and point this at it.
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account/serviceAccountKey.json
#
# Hosted (Netlify and friends): the file cannot be deployed, so set the key's
# *contents* instead and leave the path unset. Mark it secret. Raw JSON or
# base64 both work — use base64 if the dashboard mangles the newlines inside
# private_key:
#
#   base64 -i ./service-account/your-key.json | pbcopy
#
# FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Admin allowlist ────────────────────────────────────────────────────────
# Comma-separated. These emails get the super-admin role: every class, plus
# the co-teacher linking action. Removing someone here locks them out on their
# next request. Run `npm run grant` after editing.
#
# Teachers need no entry here. Any ilmTrack account with a verified email and
# role 'teacher' can sign in and see reports for its own classes; there is
# nothing to maintain per teacher.
ADMIN_EMAILS=you@example.com

# ── Timezone ───────────────────────────────────────────────────────────────
# Report date ranges are whole days in the *server's* timezone. Locally that is
# yours, so this does nothing; a hosted server usually runs in UTC, where a
# day boundary lands mid-evening for the school and reports disagree with the
# mobile app (which uses device-local time). Set this to the school's zone on
# any hosted deploy.
# TZ=America/Toronto

# ── Emulator ───────────────────────────────────────────────────────────────
# true = talk to the local Firebase emulators instead of production.
# Run in ../ilmTrack: firebase emulators:start --only auth,firestore,functions
FIREBASE_USE_EMULATOR=false
FIREBASE_EMULATOR_HOST=127.0.0.1
# The browser needs its own copy (only NEXT_PUBLIC_* vars reach client code).
# Keep these two in sync with the pair above.
NEXT_PUBLIC_FIREBASE_USE_EMULATOR=false
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
